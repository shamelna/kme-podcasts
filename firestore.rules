rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Check if user is an admin (by verified email token)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'info@kaizenmadeeasy.com' ||
        request.auth.token.email == 'ahmed.a.redwan@gmail.com' ||
        request.auth.token.email == 'eng.a.redwan@gmail.com'
      );
    }

    // Check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Episodes — public read, admin write/delete
    match /episodes/{episodeId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // Podcasts — public read, admin write/delete
    match /podcasts/{podcastId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // Tracked podcasts — public read, admin write/delete
    match /trackedPodcasts/{podcastId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // Analytics — admin only (visitors write allowed for tracking)
    match /analytics/{documentId} {
      allow read, write, delete: if isAdmin();
    }

    match /analytics/visitors/visits/{visitId} {
      allow create: if true;        // Allow anonymous visit tracking
      allow read, update, delete: if isAdmin();
    }

    match /analytics/plays/episodes/{playId} {
      allow create: if true;        // Allow anonymous play tracking
      allow read, update, delete: if isAdmin();
    }

    // Users — owner read/write, admin read/write
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
