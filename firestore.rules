rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email == 'info@kaizenmadeeasy.com';
    }
    
    // Episodes collection - public read, admin write/delete
    match /episodes/{episodeId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    
    // Podcasts collection - public read, admin write/delete
    match /podcasts/{podcastId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    
    // Tracked podcasts collection - public read, admin write/delete
    match /trackedPodcasts/{podcastId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    
    // Analytics collections - admin only
    match /analytics/{documentId} {
      allow read, write, delete: if isAdmin();
    }
    
    match /analytics/visitors/{visitId} {
      allow read, write, delete: if isAdmin();
    }
    
    match /analytics/plays/{playId} {
      allow read, write, delete: if isAdmin();
    }
    
    // User data collections - users can only access their own data
    match /users/{userId} {
      allow read, write, delete: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write, delete: if false;
    }
  }
}
